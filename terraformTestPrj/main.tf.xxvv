terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 3.6.0"
    }
  }

  required_version = ">=1.0.0"
}

provider "aws" {
  region = "us-east-2"
}

resource "aws_security_group" "ngx-sg" {
  name        = "ngx-sg"
  description = "Rules for inboud and outbound"

  ingress {
    cidr_blocks = ["0.0.0.0/0"]
    from_port   = 8081
    protocol    = "tcp"
    to_port     = 8081
  }

  egress {
    from_port   = 0
    to_port     = 0
    cidr_blocks = ["0.0.0.0/0"]
    protocol    = "-1" # semantically equivalent to all ports
  }

  tags = {
    Name = "ngx-sg"
  }
}

data "aws_ami" "ngx_dt" {
  most_recent = true
  name_regex  = "al2023-ami-2023.9.20251208.0-kernel-6.1-x86_64"
  owners      = ["137112412989"]
}

resource "aws_instance" "my_nginx" {
  instance_type          = "t2.micro"
  ami                    = data.aws_ami.ngx_dt.id
  vpc_security_group_ids = [aws_security_group.ngx-sg.id]
}